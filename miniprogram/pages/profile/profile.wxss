/* pages/profile/profile.wxss */
.container {
  padding-bottom: 164rpx;
}

.user-card {
  padding: 30rpx 28rpx;
}

.profile-head {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.profile-kicker {
  font-size: 18rpx;
  letter-spacing: 1.8rpx;
  color: rgba(145, 205, 243, 0.72);
}

.nickname {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  font-size: 38rpx;
  font-weight: 700;
  color: #eef8ff;
}

.edit-icon {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #bfe6ff;
  border: 1rpx solid rgba(110, 184, 245, 0.52);
  border-radius: 999rpx;
  padding: 8rpx 16rpx;
}

.nickname-edit {
  display: flex;
  flex-direction: column;
}

.nickname-input {
  background: rgba(9, 23, 37, 0.84);
  border: 1rpx solid rgba(103, 160, 210, 0.34);
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
  font-size: 32rpx;
  color: #e7f4ff;
  margin-bottom: 16rpx;
}

.edit-actions {
  display: flex;
  gap: 20rpx;
}

.save-btn,
.cancel-btn {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
}

.save-btn {
  background: linear-gradient(135deg, #2e73bb 0%, #3ec9c2 100%);
  color: #e7f4ff;
}

.cancel-btn {
  background: rgba(22, 44, 68, 0.72);
  color: rgba(201, 231, 252, 0.84);
  border: 1rpx solid rgba(103, 160, 210, 0.34);
}

.user-id {
  font-size: 24rpx;
  color: rgba(183, 211, 233, 0.82);
}

.stats {
  display: flex;
  justify-content: space-between;
  padding: 26rpx 8rpx;
}

.stats-item {
  text-align: center;
  flex: 1;
}

.stats-number {
  font-size: 44rpx;
  font-weight: 700;
  color: #9fdcff;
}

.stats-label {
  font-size: 24rpx;
  color: rgba(183, 211, 233, 0.82);
  margin-top: 10rpx;
}

.feedback-popup__head {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.feedback-popup {
  width: 84%;
  max-width: 640rpx;
  padding: 34rpx 30rpx;
  border-radius: 24rpx;
  box-sizing: border-box;
  background: linear-gradient(160deg, rgba(16, 34, 52, 0.96) 0%, rgba(12, 28, 44, 0.98) 100%);
  border: 1rpx solid rgba(104, 168, 224, 0.34);
  box-shadow: 0 16rpx 34rpx rgba(2, 8, 18, 0.5);
}

.feedback-popup__title {
  font-size: 32rpx;
  font-weight: 700;
  color: #e7f4ff;
}

.feedback-popup__desc {
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(183, 211, 233, 0.82);
}

.feedback-textarea {
  width: 100%;
  min-height: 220rpx;
  box-sizing: border-box;
  padding: 22rpx 24rpx;
  border-radius: 18rpx;
  background: rgba(9, 23, 37, 0.84);
  border: 1rpx solid rgba(103, 160, 210, 0.34);
  color: #e7f4ff;
  font-size: 28rpx;
  line-height: 1.7;
}

.feedback-count {
  margin-top: 12rpx;
  text-align: right;
  font-size: 22rpx;
  color: rgba(168, 210, 239, 0.74);
}

.contact-input {
  width: 100%;
  box-sizing: border-box;
  margin-top: 18rpx;
  height: 88rpx;
  padding: 0 22rpx;
  border-radius: 16rpx;
  background: rgba(9, 23, 37, 0.84);
  border: 1rpx solid rgba(103, 160, 210, 0.34);
  color: #e7f4ff;
  font-size: 28rpx;
  line-height: 88rpx;
}

.contact-input::placeholder {
  color: rgba(183, 211, 233, 0.62);
}

.feedback-submit {
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #2e73bb 0%, #3ec9c2 100%);
  color: #f4fbff;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 26rpx rgba(41, 131, 214, 0.24);
}

.feedback-actions {
  margin-top: 22rpx;
  display: flex;
  gap: 16rpx;
}

.feedback-cancel,
.feedback-submit {
  flex: 1;
}

.feedback-cancel {
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: rgba(22, 44, 68, 0.72);
  color: rgba(201, 231, 252, 0.84);
  border: 1rpx solid rgba(103, 160, 210, 0.34);
  font-size: 28rpx;
  font-weight: 600;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(103, 160, 210, 0.24);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item text:first-child {
  font-size: 30rpx;
  color: #e7f4ff;
}

.arrow {
  color: rgba(168, 221, 255, 0.78);
  font-size: 32rpx;
}

.about-popup {
  background: linear-gradient(160deg, rgba(16, 34, 52, 0.94) 0%, rgba(12, 28, 44, 0.96) 100%);
  border-radius: 24rpx;
  padding: 48rpx 34rpx;
  width: 80%;
  max-width: 600rpx;
  text-align: left;
  border: 1rpx solid rgba(104, 168, 224, 0.34);
  box-shadow: 0 16rpx 34rpx rgba(2, 8, 18, 0.5);
}

.about-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #bde9ff;
  margin-bottom: 12rpx;
}

.about-version {
  font-size: 24rpx;
  color: rgba(183, 211, 233, 0.76);
  margin-bottom: 24rpx;
}

.about-desc {
  font-size: 28rpx;
  color: #e7f4ff;
  line-height: 1.8;
  margin-bottom: 34rpx;
}

.about-close {
  background: linear-gradient(135deg, #2e73bb 0%, #3ec9c2 100%);
  color: #e7f4ff;
  padding: 16rpx 40rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  display: inline-block;
}
