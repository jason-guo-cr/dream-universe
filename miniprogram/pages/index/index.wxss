/* pages/index/index.wxss - 首页宇宙时间轴重制 */
.container {
  position: relative;
  overflow: hidden;
  padding-bottom: 164rpx;
}

.container > view:not(.cosmos-layer):not(.cosmos-stars):not(.nebula-vignette) {
  position: relative;
  z-index: 2;
}

.nebula-vignette {
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  background: radial-gradient(ellipse at center, transparent 40%, rgba(3, 9, 18, 0.35) 100%);
}

@keyframes etherealFadeIn {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes softGlow {
  0%,
  100% {
    opacity: 0.62;
    transform: scale(1);
  }

  50% {
    opacity: 1;
    transform: scale(1.06);
  }
}

@keyframes shimmer {
  0% {
    transform: translateX(-100%);
  }

  100% {
    transform: translateX(100%);
  }
}

.ethereal-fade {
  animation: etherealFadeIn 0.56s cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
  opacity: 0;
}

.cosmos-layer {
  position: absolute;
  border-radius: 50%;
  filter: blur(22rpx);
  opacity: 0.56;
  pointer-events: none;
  z-index: 0;
}

.cosmos-layer--one {
  width: 440rpx;
  height: 440rpx;
  top: -120rpx;
  right: -96rpx;
  background: radial-gradient(circle, rgba(74, 171, 255, 0.24) 0%, rgba(74, 171, 255, 0) 70%);
}

.cosmos-layer--two {
  width: 540rpx;
  height: 540rpx;
  left: -180rpx;
  top: 220rpx;
  background: radial-gradient(circle, rgba(63, 226, 206, 0.16) 0%, rgba(63, 226, 206, 0) 74%);
}

.cosmos-stars {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 1;
  background-image:
    radial-gradient(circle at 12% 18%, rgba(224, 241, 255, 0.38) 0 2rpx, transparent 2rpx),
    radial-gradient(circle at 82% 10%, rgba(224, 241, 255, 0.3) 0 2rpx, transparent 2rpx),
    radial-gradient(circle at 66% 36%, rgba(224, 241, 255, 0.22) 0 1.5rpx, transparent 1.5rpx),
    radial-gradient(circle at 24% 54%, rgba(224, 241, 255, 0.2) 0 1.5rpx, transparent 1.5rpx),
    radial-gradient(circle at 74% 74%, rgba(224, 241, 255, 0.26) 0 2rpx, transparent 2rpx),
    radial-gradient(circle at 18% 84%, rgba(224, 241, 255, 0.18) 0 1.5rpx, transparent 1.5rpx);
}

.interpret-entry {
  flex: 1;
  min-height: 92rpx;
  padding: 16rpx 18rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  gap: 4rpx;
  border-radius: 18rpx;
  border-color: rgba(110, 184, 245, 0.42);
  background:
    radial-gradient(120% 120% at 100% 0%, rgba(58, 205, 188, 0.16) 0%, transparent 40%),
    linear-gradient(150deg, rgba(14, 39, 60, 0.84) 0%, rgba(12, 33, 52, 0.9) 100%);
  box-shadow:
    0 12rpx 28rpx rgba(4, 12, 24, 0.32),
    inset 0 0 0 1rpx rgba(115, 190, 245, 0.08);
}

.interpret-title {
  font-size: 29rpx;
  font-weight: 700;
  color: #e8f7ff;
  line-height: 1.2;
}

.interpret-subtitle {
  font-size: 22rpx;
  color: rgba(185, 224, 247, 0.82);
  line-height: 1.25;
}

.interpret-entry--active {
  transform: translateY(-1rpx) scale(0.994);
  border-color: rgba(124, 210, 248, 0.64);
  box-shadow:
    0 16rpx 34rpx rgba(4, 12, 24, 0.4),
    0 0 0 2rpx rgba(122, 204, 246, 0.16);
}

.date-filter {
  margin-bottom: 16rpx;
}

.date-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 22rpx;
  background: rgba(9, 23, 37, 0.84);
  border-radius: 16rpx;
  border: 1rpx solid rgba(103, 160, 210, 0.32);
}

.date-picker .arrow {
  font-size: 18rpx;
  color: #8fd4ff;
}

.date-picker text:first-child {
  color: #dff1ff;
  font-size: 26rpx;
}

.ethereal-timeline {
  position: relative;
  padding-left: 24rpx;
}

.ethereal-timeline::before {
  content: '';
  position: absolute;
  left: 6rpx;
  top: 0;
  bottom: 0;
  width: 1rpx;
  background: linear-gradient(180deg,
      rgba(87, 185, 255, 0) 0%,
      rgba(87, 185, 255, 0.34) 12%,
      rgba(87, 185, 255, 0.2) 52%,
      rgba(87, 185, 255, 0.08) 90%,
      rgba(87, 185, 255, 0) 100%);
}

.timeline-date-group {
  margin-bottom: 32rpx;
  position: relative;
}

.timeline-date-marker {
  position: relative;
  margin-bottom: 20rpx;
  padding-left: 32rpx;
  display: flex;
  align-items: center;
}

.date-glow {
  position: absolute;
  left: -4rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(87, 185, 255, 0.9) 0%, rgba(87, 185, 255, 0) 72%);
  animation: softGlow 3s ease-in-out infinite;
}

.date-glow::before {
  content: '';
  position: absolute;
  inset: 4rpx;
  border-radius: 50%;
  background: #57b9ff;
  box-shadow: 0 0 12rpx rgba(87, 185, 255, 0.62);
}

.date-content {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.date-day {
  font-size: 26rpx;
  color: #bfe8ff;
  font-weight: 500;
  text-shadow: 0 0 18rpx rgba(87, 185, 255, 0.28);
}

.dream-count {
  font-size: 22rpx;
  color: rgba(172, 219, 250, 0.62);
  font-weight: 300;
}

.timeline-dreams {
  padding-left: 32rpx;
}

.timeline-card {
  position: relative;
  margin-bottom: 16rpx;
  border-radius: 20rpx;
  background: linear-gradient(160deg,
      rgba(16, 34, 52, 0.78) 0%,
      rgba(12, 29, 45, 0.7) 54%,
      rgba(16, 36, 55, 0.78) 100%);
  border: 1rpx solid rgba(109, 172, 227, 0.2);
  overflow: hidden;
  backdrop-filter: blur(12rpx);
  transition: all 0.28s cubic-bezier(0.22, 0.61, 0.36, 1);
}

.card-glow {
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle at 30% 20%, rgba(87, 185, 255, 0.08) 0%, transparent 52%);
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.34s ease;
}

.timeline-card--active {
  transform: translateY(-2rpx) scale(1.01);
  border-color: rgba(87, 185, 255, 0.42);
  box-shadow:
    0 18rpx 38rpx rgba(3, 9, 19, 0.42),
    0 0 28rpx rgba(87, 185, 255, 0.1) inset;
}

.timeline-card--active .card-glow {
  opacity: 1;
}

.card-content {
  padding: 24rpx;
  position: relative;
  z-index: 1;
}

.dream-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.dream-index {
  font-size: 20rpx;
  color: rgba(173, 220, 252, 0.72);
  font-weight: 300;
  letter-spacing: 1rpx;
}

.dream-tags {
  display: flex;
  gap: 10rpx;
}

.tag {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  padding: 6rpx 14rpx;
  background: rgba(87, 185, 255, 0.1);
  color: rgba(189, 232, 255, 0.94);
  border-radius: 999rpx;
  font-size: 20rpx;
  border: 1rpx solid rgba(97, 181, 244, 0.28);
  font-weight: 300;
}

.tag-glow {
  background: rgba(87, 185, 255, 0.14);
  box-shadow: 0 0 12rpx rgba(87, 185, 255, 0.18);
}

.tag-icon {
  font-size: 16rpx;
  opacity: 0.86;
}

.ethereal-text {
  font-size: 28rpx;
  color: rgba(229, 244, 255, 0.95);
  line-height: 1.75;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
  font-weight: 300;
  letter-spacing: 0.5rpx;
}

.ethereal-images {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.quick-actions {
  margin-top: 18rpx;
  display: flex;
  gap: 12rpx;
}

.quick-btn {
  flex: 1;
  min-width: 0;
  height: 56rpx;
  padding: 0 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  border: 1rpx solid rgba(110, 184, 245, 0.46);
  color: #bfe6ff;
  background: linear-gradient(150deg, rgba(18, 44, 66, 0.74) 0%, rgba(15, 38, 58, 0.62) 100%);
  font-size: 23rpx;
  line-height: 1;
  font-weight: 600;
  letter-spacing: 0.4rpx;
  box-shadow: 0 8rpx 18rpx rgba(4, 12, 24, 0.22);
  box-sizing: border-box;
  transition: transform 160ms ease, box-shadow 160ms ease, border-color 160ms ease;
}

.quick-btn--active {
  transform: translateY(-1rpx) scale(0.985);
  border-color: rgba(133, 208, 255, 0.62);
  box-shadow:
    0 12rpx 22rpx rgba(4, 12, 24, 0.32),
    0 0 0 2rpx rgba(108, 193, 250, 0.14);
}

.quick-btn-edit {
  background: linear-gradient(150deg, rgba(23, 52, 77, 0.78) 0%, rgba(18, 44, 66, 0.68) 100%);
}

.quick-btn-interpret {
  background:
    radial-gradient(120% 120% at 100% 0%, rgba(83, 201, 208, 0.16) 0%, transparent 52%),
    linear-gradient(150deg, rgba(18, 47, 74, 0.76) 0%, rgba(16, 42, 64, 0.68) 100%);
}

.quick-btn-danger {
  border-color: rgba(242, 106, 106, 0.56);
  color: #ffc0c0;
  background: linear-gradient(150deg, rgba(82, 33, 42, 0.74) 0%, rgba(68, 28, 36, 0.66) 100%);
}

.quick-btn-danger--active {
  border-color: rgba(255, 128, 142, 0.78);
  box-shadow:
    0 12rpx 24rpx rgba(38, 8, 12, 0.44),
    0 0 0 2rpx rgba(255, 126, 140, 0.16);
}

.ethereal-image-wrapper {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.ethereal-image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
  object-fit: cover;
  border: 1rpx solid rgba(104, 160, 212, 0.32);
}

.image-shimmer {
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.12), transparent);
  animation: shimmer 2s infinite;
}

.card-hint {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 24rpx;
  border-top: 1rpx solid rgba(87, 185, 255, 0.1);
}

.hint-text {
  font-size: 20rpx;
  color: rgba(170, 218, 251, 0.56);
  font-weight: 300;
}

.hint-line {
  flex: 1;
  height: 1rpx;
  background: linear-gradient(90deg, rgba(87, 185, 255, 0.24), transparent);
}

.quote {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 18rpx;
  border-radius: 16rpx;
  background:
    linear-gradient(90deg, rgba(18, 41, 63, 0.86) 0%, rgba(12, 31, 49, 0.68) 100%);
  border: 1rpx solid rgba(87, 185, 255, 0.18);
  box-shadow: 0 8rpx 22rpx rgba(2, 10, 18, 0.24);
  backdrop-filter: blur(8rpx);
}

.quote-mark {
  flex-shrink: 0;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(87, 185, 255, 0.12);
  border: 1rpx solid rgba(87, 185, 255, 0.2);
  color: #9edcff;
  font-size: 18rpx;
  letter-spacing: 0.8rpx;
  text-transform: uppercase;
}

.quote-text {
  min-width: 0;
  color: rgba(223, 241, 255, 0.9);
  font-size: 24rpx;
  line-height: 1.35;
  font-style: italic;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.empty {
  position: relative;
  text-align: center;
  padding: 84rpx 20rpx;
  color: rgba(183, 211, 233, 0.82);
}

.empty-glow {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(circle, rgba(87, 185, 255, 0.12) 0%, transparent 70%);
  pointer-events: none;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  line-height: 120rpx;
  text-align: center;
  font-size: 60rpx;
  color: rgba(118, 196, 247, 0.56);
  margin-bottom: 24rpx;
  border-radius: 50%;
  background: rgba(87, 185, 255, 0.1);
  border: 1rpx solid rgba(87, 185, 255, 0.24);
  animation: softGlow 3s ease-in-out infinite;
}

.empty-title {
  display: block;
  font-size: 28rpx;
  color: rgba(214, 237, 255, 0.94);
  margin-bottom: 10rpx;
  font-weight: 300;
}

.empty-subtitle {
  display: block;
  font-size: 24rpx;
  color: rgba(183, 211, 233, 0.66);
  font-weight: 300;
}

.loading {
  text-align: center;
  padding: 32rpx;
  color: rgba(173, 208, 236, 0.82);
  position: relative;
}

.loading-glow {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 100rpx;
  height: 100rpx;
  background: radial-gradient(circle, rgba(87, 185, 255, 0.16) 0%, transparent 70%);
  animation: softGlow 2s ease-in-out infinite;
}

.loading-more {
  border: 1rpx solid rgba(103, 160, 210, 0.26);
  border-radius: 16rpx;
  background: rgba(15, 33, 52, 0.56);
  backdrop-filter: blur(8rpx);
  position: relative;
  overflow: hidden;
}

.more-glow {
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at center, rgba(87, 185, 255, 0.12) 0%, transparent 72%);
  opacity: 0;
  transition: opacity 0.3s;
}

.loading-more:active .more-glow {
  opacity: 1;
}
